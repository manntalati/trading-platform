<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS: keep the dashboard's server running, and with it the job scheduler (data jobs and
  recommendations), from login on. `make mac-agent` installs it with REPO filled in; see
  infra/README.md. Output goes to data/logs/tp-api.log.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.trading-platform.api</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "REPO" &amp;&amp; mkdir -p data/logs &amp;&amp; exec .venv/bin/tp-api --quotes alpaca &gt;&gt; data/logs/tp-api.log 2&gt;&amp;1</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
</dict>
</plist>
