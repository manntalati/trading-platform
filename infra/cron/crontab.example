# Alternative to the systemd timers (prefer those: DST-aware, logs in the journal, failure hook).
#
# Debian/Ubuntu cron has no per-job time zone, so times here are UTC and chosen to land after
# the US close in both EST and EDT: 23:30 UTC = 18:30 EST / 19:30 EDT.
#
# Install: mkdir -p data/logs; crontab -e, paste, and fix the path. Output goes to data/logs/.

REPO=/home/YOU/trading-platform

# m  h  dom mon dow  command
30 23 *   *   1-5    cd $REPO && .venv/bin/tp-data bars daily >> $REPO/data/logs/bars-daily.log 2>&1

# Options snapshot must run while the market is open: 19:45 UTC = 15:45 EDT / 14:45 EST, inside
# regular hours either way (the systemd timer keeps it at 15:45 New York all year).
45 19 *   *   1-5    cd $REPO && .venv/bin/tp-data options snapshot >> $REPO/data/logs/options.log 2>&1
