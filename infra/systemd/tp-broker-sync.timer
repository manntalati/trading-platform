# Hourly on weekdays, 07:30-21:30 New York: SnapTrade refreshes its copy of the Fidelity data
# once a day (around the close; transactions the next day), and each sync is free, so this picks
# it up soon after. The dashboard's "Refresh from Fidelity" button forces a fresh pull on demand.
[Unit]
Description=trading-platform: brokerage portfolio sync (weekdays, hourly 07:30-21:30 ET)

[Timer]
OnCalendar=Mon..Fri 07..21:30 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
