# 07:30 New York time on weekdays: FRED usually posts a day's VIX close and Treasury yields by the
# next morning, so the regimes are current before the open. The 30-day overlap catches late
# postings.
[Unit]
Description=trading-platform: FRED macro series (weekdays 07:30 ET)

[Timer]
OnCalendar=Mon..Fri 07:30 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
