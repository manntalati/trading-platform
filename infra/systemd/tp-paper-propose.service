# Paper trading, evening: sync fills, mark each sleeve at the close, run every strategy in
# config/paper.toml and record its proposals (risk-checked). Needs today's bars, so it runs after
# tp-bars-daily. Approve in the dashboard (or `tp-paper approve`) before the morning submit.
[Unit]
Description=trading-platform: paper-trading proposals
Wants=network-online.target
After=network-online.target
OnFailure=tp-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/trading-platform
ExecStart=%h/trading-platform/.venv/bin/tp-paper propose
TimeoutStartSec=15min
Nice=10
