# Paper trading: record fills and order updates, reconcile the ledger with the broker.
[Unit]
Description=trading-platform: paper-trading fills and reconciliation
Wants=network-online.target
After=network-online.target
OnFailure=tp-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/trading-platform
ExecStart=%h/trading-platform/.venv/bin/tp-paper sync
TimeoutStartSec=5min
