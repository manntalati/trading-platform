# After the opening auction fills (09:45) and after the close (16:30), New York, weekdays.
[Unit]
Description=trading-platform: paper-trading fills and reconciliation (weekdays 09:45, 16:30 ET)

[Timer]
OnCalendar=Mon..Fri 09:45 America/New_York
OnCalendar=Mon..Fri 16:30 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
