# Paper trading, morning: approved proposals become market-on-open orders on the Alpaca paper
# account; proposals still waiting for a decision expire. Refused while the kill switch is on.
[Unit]
Description=trading-platform: paper-trading order submission
Wants=network-online.target
After=network-online.target
OnFailure=tp-notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/trading-platform
ExecStart=%h/trading-platform/.venv/bin/tp-paper submit
TimeoutStartSec=5min
