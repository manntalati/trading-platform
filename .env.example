# Copy to .env (git-ignored) and fill in. Use PAPER keys: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
TP_ALPACA_PAPER=true

# Where the Parquet lake lives (raw/, clean/, reports/). Relative paths are relative to the
# directory you run commands from.
TP_DATA_ROOT=data

# Stock bars feed: sip (all US venues; free for data older than 15 minutes), iex, delayed_sip
TP_BARS_FEED=sip

TP_UNIVERSES_FILE=config/universes.toml

# Optional: Discord webhook for job-failure alerts (infra/systemd/tp-notify-failure@.service)
# TP_DISCORD_WEBHOOK_URL=
