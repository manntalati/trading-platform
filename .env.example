# Copy to .env (git-ignored) and fill in. Use PAPER keys: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
TP_ALPACA_PAPER=true

# Where the Parquet lake lives (raw/, clean/, reports/). Relative paths are relative to the
# directory you run commands from.
TP_DATA_ROOT=data

# Stock bars feed: sip (all US venues; free for data older than 15 minutes), iex, delayed_sip
TP_BARS_FEED=sip

TP_UNIVERSES_FILE=config/universes.toml

# Optional: Discord webhook for job-failure alerts (infra/systemd/tp-notify-failure@.service)
# TP_DISCORD_WEBHOOK_URL=

# Options snapshot feeds (free plan: indicative options, IEX stock quotes)
TP_OPTIONS_FEED=indicative
TP_QUOTES_FEED=iex

# Brokerage (read-only): SnapTrade personal API key, used to link Fidelity.
# Create one at https://dashboard.snaptrade.com, then `uv run tp-broker link`.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# Dashboard API: required before binding tp-api to anything but localhost.
# TP_DASHBOARD_TOKEN=
# Host names the dashboard answers to; add the one you reach it by remotely (e.g. Tailscale).
# TP_DASHBOARD_HOSTS=localhost,127.0.0.1

# Paper trading (tp-paper) always uses Alpaca's paper endpoint with the keys above, whatever
# TP_ALPACA_PAPER says. The book lives in config/paper.toml; `fake` simulates the account offline.
# TP_PAPER_FILE=config/paper.toml
# TP_PAPER_BROKER=alpaca

# VIX and Treasury yields (`tp-data macro`) come from Cboe and the Treasury without a key. A free
# FRED API key (https://fred.stlouisfed.org/docs/api/api_key.html) makes FRED the first source.
# FRED_API_KEY=

# Company fundamentals and earnings dates from SEC EDGAR (`tp-data fundamentals`): no key, but
# the SEC asks for a name and an email address in every request.
# TP_SEC_USER_AGENT="trading-platform you@example.com"

# Option maths (implied volatility, greeks, odds): annual risk-free rate. Used only until
# `tp-data macro daily` has downloaded the 3-month Treasury yield (or if it goes stale).
# TP_RISK_FREE_RATE=0.04

# "Ask Claude" about a position on the Positions page (optional). Billed to your Anthropic API
# account; the positions and your question are sent to Anthropic with each question.
# ANTHROPIC_API_KEY=
# TP_CLAUDE_MODEL=claude-opus-5-5
# TP_CLAUDE_EFFORT=medium
# TP_CLAUDE_WEB_SEARCH=true
# News sentiment: the scheduler has Claude score the day's headlines (tp-data news score) only
# with this on; it costs API tokens. TP_NEWS_MODEL defaults to TP_CLAUDE_MODEL.
# TP_NEWS_SCORING=on
# TP_NEWS_MODEL=claude-opus-5-5
